/* ===== Soft Rose - UtilityTool =====
 *
 * The app's single theme. See DESIGN.md for the token table this implements.
 *
 * Tokens (QSS has no variables, so the values are written out; if one changes,
 * change it everywhere it appears in this file and nowhere else in the app):
 *   bg             #fafafa            page ground
 *   bg-elev        #ffffff            panel / card surfaces
 *   bg-elev-2      #f0f0f1            hover / pressed
 *   border         rgba(24,24,27,.08) hairline dividers, panel outline
 *   border-strong  rgba(24,24,27,.16) input / button borders
 *   text           #18181b            primary
 *   text-muted     #52525b            secondary
 *   text-faint     #71717a            tertiary, hints, metadata
 *   text-disabled  #a1a1aa            disabled controls ONLY -- deliberately
 *                                     below the 4.5:1 body-text floor, and
 *                                     exempt from it (WCAG 1.4.3). Never use
 *                                     it for text the user has to read.
 *   accent         #a8354e            interaction only - focus, active nav,
 *                                     primary button, progress fill
 *   accent-hover   #bd3c58            accent, lifted
 *   accent-press   #8e2c42            accent, depressed
 *   accent-text    #ffffff            on top of an accent-filled surface
 *   success        #1f8a5c   error #c23b32   warn #a66a0c   (status only;
 *                                     error is reused for the #Danger button
 *                                     -- see ConfirmDialog in widgets/common.py)
 *   radius-s       6px                small controls
 *   radius-m       10px               panels, cards, drop zones
 *
 * Typeface: Geist (400/500/600/700), bundled as .ttf in assets/fonts/ and
 * registered by load_fonts() in main.py before this sheet is applied. It has
 * to be bundled -- the app makes no network calls, so there is no webfont
 * route, and a family that is merely *named* here resolves to whatever the OS
 * happens to have. That is exactly what the previous "Public Sans" rule did:
 * it is not a system font on Windows or macOS and was never bundled, so the
 * app rendered in a fallback face for as long as the rule existed. Do not add
 * a font-family here for a face that is not in assets/fonts/.
 *
 * Card/panel elevation is a soft drop shadow, which QSS cannot express. It is
 * applied programmatically by apply_card_shadows() in main.py to every QFrame
 * named "Card" or "Sidebar"; the 1px border below only crisps the edge.
 */

/* ===== Base ===== */
QWidget {
    background-color: #fafafa;
    color: #18181b;
    font-family: "Geist", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: #fafafa;
    color: #18181b;
}

/* ===== Sidebar ===== */
#Sidebar {
    background-color: #ffffff;
    border: 1px solid rgba(24, 24, 27, 0.08);
    border-radius: 10px;
}

/* App Title in Sidebar */
#AppTitle {
    background: transparent;
    font-size: 20px;
    font-weight: 700;
    color: #18181b;
    letter-spacing: -0.2px;
    padding: 6px 8px 20px 8px;
    margin-bottom: 12px;
}

/* Sidebar Navigation Buttons */
#Sidebar QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 12px 16px;
    color: #52525b;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
    margin: 0px 0px 8px 0px;
}

#Sidebar QPushButton:hover {
    background-color: #f0f0f1;
    color: #18181b;
}

#Sidebar QPushButton:checked {
    background-color: #a8354e;
    color: #ffffff;
    font-weight: 600;
    border: none;
}

/* Keyboard focus on the sidebar. A ring rather than the hover fill on
   purpose: Qt hands focus to the first nav button the moment the window
   opens, so a fill would leave the app looking as if something were hovered
   before the user has touched anything. The padding drops by 1px to absorb
   the border, so focusing a button never nudges the nav. */
#Sidebar QPushButton:focus {
    border: 1px solid #a8354e;
    padding: 11px 15px;
}

#Sidebar QPushButton:checked:focus {
    background-color: #8e2c42;
    border: 1px solid #8e2c42;
    color: #ffffff;
}

/* ===== Cards & Panels ===== */
QFrame#Card {
    background-color: #ffffff;
    border: 1px solid rgba(24, 24, 27, 0.08);
    border-radius: 10px;
    padding: 24px;
}

/* Keyboard-focus ring for a clickable Card (e.g. Home's EntryCard) -- same
   accent treatment as every other focusable control below. A no-op for
   non-interactive Card frames, which never receive Qt focus. */
QFrame#Card:focus {
    border: 1px solid #a8354e;
}

/* ===== Typography ===== */
QLabel {
    background: transparent;
    color: #18181b;
}

QLabel#H1 {
    font-size: 28px;
    font-weight: 700;
    color: #18181b;
    letter-spacing: -0.4px;
    margin-bottom: 8px;
    padding: 0px;
}

QLabel#H2 {
    font-size: 16px;
    font-weight: 600;
    color: #18181b;
    margin: 0px 0px 16px 0px;
    padding: 0px;
}

QLabel#FormLabel {
    font-size: 13px;
    font-weight: 500;
    color: #52525b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QLabel#Hint {
    color: #71717a;
}

/* Group heading inside a panel -- section_header() in widgets/common.py.
   A long form is grouped with these plus spacing, never with a bordered box
   per group (a card inside #Card is a card within a card).

   The margins are deliberately asymmetric: more space above a heading than
   below it, so the heading reads as belonging to the fields under it rather
   than floating between two groups. Do not even them out. */
QLabel#SectionHeader {
    font-size: 12px;
    font-weight: 600;
    color: #52525b;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    border-bottom: 1px solid rgba(24, 24, 27, 0.08);
    padding-bottom: 6px;
    margin: 16px 0px 4px 0px;
}

/* Hairline between repeated rows in a list -- divider() in
   widgets/common.py. Fainter than --border: it separates rows of one table,
   where the panel outline separates the table from the page. */
QFrame#Divider {
    background: rgba(24, 24, 27, 0.07);
    border: none;
    min-height: 1px;
    max-height: 1px;
}

/* Small bordered status tag -- Duplicates' KEEP marker and its similarity
   badge. Neutral on purpose: the accent is reserved for focus/hover/selection
   (DESIGN.md), and the status colours mean success/error/warning, which a
   "this is the copy being kept" marker is none of. Same bordered-tag register
   as the comp's NOT YET BUILT tag. */
QLabel#Tag {
    color: #52525b;
    border: 1px solid rgba(24, 24, 27, 0.16);
    border-radius: 6px;
    padding: 1px 6px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.4px;
}

/* Status text -- the three status tokens, used where a colour carries real
   meaning and nowhere else (DESIGN.md: "colour as data, never decoration").
   Backup's Restore column is the first user: a job whose source has drifted
   since its last backup reads warn, a job whose last run failed reads error,
   an up-to-date job reads success. Named here rather than written inline at
   the call site so the tokens stay in this file, as the header requires. */
QLabel#StatusOk {
    color: #1f8a5c;
}

QLabel#StatusWarn {
    color: #a66a0c;
}

QLabel#StatusError {
    color: #c23b32;
}

QLabel:disabled {
    color: #71717a;
}

/* ===== Form Inputs ===== */
QLineEdit, QTextEdit {
    background-color: #ffffff;
    color: #18181b;
    border: 1px solid rgba(24, 24, 27, 0.16);
    border-radius: 6px;
    padding: 9px 12px;
    font-size: 14px;
    selection-background-color: #a8354e;
    selection-color: #ffffff;
}

QLineEdit:hover, QTextEdit:hover {
    border-color: rgba(24, 24, 27, 0.28);
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #a8354e;
    background-color: #ffffff;
    outline: none;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #f0f0f1;
    color: #71717a;
}

/* ===== Combo Boxes ===== */
QComboBox {
    background-color: #ffffff;
    color: #18181b;
    border: 1px solid rgba(24, 24, 27, 0.16);
    border-radius: 6px;
    padding: 9px 12px;
    font-size: 14px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: rgba(24, 24, 27, 0.28);
}

QComboBox:focus {
    border: 1px solid #a8354e;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #52525b;
    width: 0px;
    height: 0px;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid rgba(24, 24, 27, 0.08);
    border-radius: 10px;
    color: #18181b;
    selection-background-color: #a8354e;
    selection-color: #ffffff;
    padding: 5px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 6px;
    min-height: 25px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #f0f0f1;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #a8354e;
    color: #ffffff;
}

/* ===== Spin Boxes ===== */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #18181b;
    border: 1px solid rgba(24, 24, 27, 0.16);
    border-radius: 6px;
    padding: 9px 12px;
    font-size: 14px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: rgba(24, 24, 27, 0.28);
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #a8354e;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #f0f0f1;
    border: none;
    border-radius: 4px;
    width: 20px;
    margin: 2px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #e4e4e7;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 4px solid #52525b;
    width: 0px;
    height: 0px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid #52525b;
    width: 0px;
    height: 0px;
}

/* ===== Sliders ===== */
QSlider::groove:horizontal {
    background: #f0f0f1;
    height: 6px;
    border-radius: 3px;
    border: 1px solid rgba(24, 24, 27, 0.08);
}

QSlider::sub-page:horizontal {
    background: #a8354e;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
    border: 2px solid #a8354e;
}

QSlider::handle:horizontal:hover {
    background: #a8354e;
}

QSlider::handle:horizontal:focus {
    background: #a8354e;
}

/* ===== Checkboxes ===== */
QCheckBox {
    background: transparent;
    color: #18181b;
    spacing: 8px;
    font-size: 14px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 1px solid rgba(24, 24, 27, 0.16);
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: rgba(24, 24, 27, 0.28);
}

QCheckBox::indicator:checked {
    background-color: #a8354e;
    border-color: #a8354e;
}

QCheckBox::indicator:checked:hover {
    background-color: #bd3c58;
    border-color: #bd3c58;
}

/* The pseudo-state goes on the subcontrol, not on the widget:
   `QCheckBox:focus::indicator` is silently ignored by Qt -- it applies no
   rule and raises no error, so the checkbox simply keeps looking unfocused.
   Verified by rendering the widget focused and unfocused and comparing the
   pixels, which is the only thing that distinguishes a working selector from
   a typo here. Same reason the slider handle's rule above is written
   `::handle:horizontal:focus`. */
QCheckBox::indicator:focus {
    border: 2px solid #a8354e;
}

/* A checked box is already accent-filled with an accent border, so the ring
   above would vanish on it -- it takes the darker pressed shade instead, the
   same trick #Primary:focus uses. */
QCheckBox::indicator:checked:focus {
    border: 2px solid #8e2c42;
}

/* A disabled category checkbox (Cleanup: "nothing found", or the Recycle Bin
   row, which is reported but not cleanable) looked identical to a live one
   before this -- the row read as clickable and did nothing. */
QCheckBox:disabled {
    color: #a1a1aa;
}

QCheckBox::indicator:disabled {
    background-color: #f0f0f1;
    border-color: rgba(24, 24, 27, 0.08);
}

/* ===== Buttons ===== */
QPushButton {
    background-color: #ffffff;
    color: #18181b;
    border: 1px solid rgba(24, 24, 27, 0.16);
    border-radius: 6px;
    padding: 9px 18px;
    font-size: 14px;
    font-weight: 500;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #f0f0f1;
    border-color: rgba(24, 24, 27, 0.28);
}

QPushButton:pressed {
    background-color: #e4e4e7;
}

/* Keyboard focus. Qt stops drawing its own focus rectangle once a widget is
   styled by QSS, so without these rules a Tab-only user has no idea where
   they are -- every button looked identical focused and unfocused. QSS has
   no outline or box-shadow, so the ring is the border, held at 1px so
   focusing something never nudges the layout. The accent-filled buttons
   below take their pressed shade instead, since an accent border on an
   accent fill is invisible. */
QPushButton:focus {
    border-color: #a8354e;
    background-color: rgba(168, 53, 78, 0.06);
}

QPushButton:disabled {
    background-color: #f0f0f1;
    color: #71717a;
    border-color: rgba(24, 24, 27, 0.08);
}

/* Primary Button - the one accent-filled surface on a screen */
QPushButton#Primary {
    background-color: #a8354e;
    color: #ffffff;
    border: 1px solid #a8354e;
    font-weight: 600;
}

QPushButton#Primary:hover {
    background-color: #bd3c58;
    border-color: #bd3c58;
}

QPushButton#Primary:pressed {
    background-color: #8e2c42;
    border-color: #8e2c42;
}

QPushButton#Primary:focus {
    background-color: #8e2c42;
    border-color: #8e2c42;
}

QPushButton#Primary:disabled {
    background-color: #f0f0f1;
    color: #71717a;
    border-color: rgba(24, 24, 27, 0.08);
}

/* Secondary Button - outline */
QPushButton#Secondary {
    background-color: transparent;
    border: 1px solid rgba(24, 24, 27, 0.16);
    color: #52525b;
    font-weight: 500;
}

QPushButton#Secondary:hover {
    border-color: #a8354e;
    color: #a8354e;
    background-color: rgba(168, 53, 78, 0.06);
}

QPushButton#Secondary:pressed {
    background-color: rgba(168, 53, 78, 0.12);
}

QPushButton#Secondary:focus {
    border-color: #a8354e;
    color: #a8354e;
    background-color: rgba(168, 53, 78, 0.06);
}

/* A #Secondary button has no fill, so its disabled state has only the text
   and border to carry -- at #71717a it was near-indistinguishable from the
   enabled #52525b, and Cleanup's "Show files" on an empty category read as
   pressable. */
QPushButton#Secondary:disabled {
    color: #a1a1aa;
    border-color: rgba(24, 24, 27, 0.08);
    background-color: transparent;
}

/* Danger Button - the confirm action in ConfirmDialog (widgets/common.py)
   and any other destructive confirmation. Uses --error, not the rose
   interaction accent, so a destructive confirm reads distinctly from
   ordinary primary actions. */
QPushButton#Danger {
    background-color: #c23b32;
    color: #ffffff;
    border: 1px solid #c23b32;
    font-weight: 600;
}

QPushButton#Danger:hover {
    background-color: #d14840;
    border-color: #d14840;
}

QPushButton#Danger:pressed {
    background-color: #a83229;
    border-color: #a83229;
}

QPushButton#Danger:focus {
    background-color: #a83229;
    border-color: #a83229;
}

QPushButton#Danger:disabled {
    background-color: #f0f0f1;
    color: #71717a;
    border-color: rgba(24, 24, 27, 0.08);
}

/* ===== Empty State (widgets/common.py) ===== */
#EmptyState {
    background: transparent;
}

/* Plain container widgets sitting inside a QFrame#Card (e.g. the Disk
   Overview breakdown rows in tabs/disk_tab.py). The base QWidget rule above
   gives every widget the page ground, which would paint a grey block over
   the card's white surface -- same reason #EmptyState is transparent. */
#CardBody {
    background: transparent;
}

/* ===== List Widgets (double as file drop zones) ===== */
QListWidget {
    background-color: #ffffff;
    border: 2px dashed rgba(24, 24, 27, 0.16);
    border-radius: 10px;
    color: #18181b;
    outline: none;
    padding: 8px;
}

QListWidget:focus {
    border-color: #a8354e;
}

QListWidget::item {
    background-color: #ffffff;
    border: 1px solid rgba(24, 24, 27, 0.08);
    border-radius: 6px;
    padding: 10px 14px;
    margin: 4px 0px;
    color: #18181b;
}

QListWidget::item:hover {
    background-color: #f0f0f1;
    border-color: rgba(24, 24, 27, 0.16);
}

QListWidget::item:selected {
    background-color: rgba(168, 53, 78, 0.10);
    border-color: #a8354e;
    color: #18181b;
}

/* ===== Drop Zone ===== */
QFrame#dropZone {
    background-color: #ffffff;
    border: 2px dashed rgba(24, 24, 27, 0.16);
    border-radius: 10px;
    min-height: 200px;
}

QFrame#dropZone:hover {
    border-color: #a8354e;
    background-color: rgba(168, 53, 78, 0.04);
}

QLabel#dropLabel {
    color: #71717a;
    font-size: 16px;
    font-weight: 500;
}

/* ===== Progress Bars ===== */
QProgressBar {
    background-color: #f0f0f1;
    border: 1px solid rgba(24, 24, 27, 0.08);
    border-radius: 6px;
    text-align: center;
    color: #52525b;
    font-size: 13px;
    font-weight: 500;
    height: 22px;
}

QProgressBar::chunk {
    background-color: #a8354e;
    border-radius: 5px;
}

/* ===== Scrollbars ===== */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    border-radius: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #d4d4d8;
    min-height: 30px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #a1a1aa;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    border-radius: 6px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #d4d4d8;
    min-width: 30px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #a1a1aa;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ===== Tab Widget ===== */
QTabWidget::pane {
    border: none;
    background: #fafafa;
    border-radius: 0px;
}

QTabBar::tab {
    background: transparent;
    color: #52525b;
    padding: 10px 20px;
    border: none;
    border-radius: 6px 6px 0px 0px;
    margin-right: 4px;
    font-weight: 500;
}

QTabBar::tab:hover {
    background: #f0f0f1;
    color: #18181b;
}

QTabBar::tab:selected {
    background: #a8354e;
    color: #ffffff;
    font-weight: 600;
}

/* ===== Tooltips ===== */
QToolTip {
    background-color: #ffffff;
    color: #18181b;
    border: 1px solid rgba(24, 24, 27, 0.16);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
}

/* ===== Menu Bars ===== */
QMenuBar {
    background-color: #ffffff;
    color: #18181b;
    border-bottom: 1px solid rgba(24, 24, 27, 0.08);
}

QMenuBar::item {
    background: transparent;
    padding: 8px 12px;
}

QMenuBar::item:selected {
    background: #f0f0f1;
    border-radius: 6px;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid rgba(24, 24, 27, 0.08);
    border-radius: 10px;
    color: #18181b;
    padding: 8px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #a8354e;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: rgba(24, 24, 27, 0.08);
    margin: 8px 12px;
}

/* ===== Status Bar ===== */
QStatusBar {
    background-color: #ffffff;
    color: #52525b;
    border-top: 1px solid rgba(24, 24, 27, 0.08);
}

/* ===== Dialogs ===== */
QDialog {
    background-color: #fafafa;
    color: #18181b;
}

QMessageBox {
    background-color: #fafafa;
}

QMessageBox QLabel {
    color: #18181b;
}

QFileDialog {
    background-color: #fafafa;
    color: #18181b;
}

/* ===== Group Boxes ===== */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid rgba(24, 24, 27, 0.08);
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: 600;
    color: #18181b;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #52525b;
}

/* ===== Splitter ===== */
QSplitter::handle {
    background: rgba(24, 24, 27, 0.08);
}

QSplitter::handle:hover {
    background: #a8354e;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}
