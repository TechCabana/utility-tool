/* ===== Base ===== */
QWidget {
    background-color: #121212;
    color: #f5f5f5;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
}

/* Global Dark Theme */
QMainWindow {
    background-color: #121212;
    color: #ffffff;
}

QTabWidget::pane {
    border: none;
    background: #1e1e1e;
}

QTabBar::tab {
    background: #2a2a2a;
    color: white;
    padding: 10px 18px;
    border-radius: 6px;
    margin: 2px;
}

QTabBar::tab:selected {
    background: qlineargradient(spread:pad x1:0 y1:0 x2:1 y2:0 stop:0 #00c853 stop:1 #64dd17);
    color: black;
    font-weight: bold;
}

/* App title in sidebar */
#AppTitle {
    font-size: 18px;
    font-weight: 700;
    padding: 6px 4px 14px 4px;
    color: #eaeaea;
}

/* Sidebar panel */
#Sidebar {
    background-color: #161616;
    border: 1px solid #212121;
    border-radius: 14px;
}

/* Sidebar buttons (navigation) */
#Sidebar QPushButton {
    background-color: #1d1d1d;
    border: 1px solid #252525;
    border-radius: 10px;
    padding: 10px 12px;
    color: #f5f5f5;
}

#Sidebar QPushButton:hover {
    background-color: #242424;
}

#Sidebar QPushButton:checked {
    background-color: #00c896; /* teal accent */
    color: #111111;
    font-weight: 700;
    border: 1px solid #00c896;
}

/* Cards / panels */
QFrame#Card {
    background-color: #1a1a1a;
    border: 1px solid #262626;
    border-radius: 12px;
    padding: 16px;
}

/* Headings */
QLabel#H1 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 8px;
}
QLabel#H2 {
    font-size: 15px;
    font-weight: 600;
    margin: 4px 0 6px 0;
    color: #dcdcdc;
}

/* Inputs */
QLineEdit, QComboBox, QTextEdit, QListWidget, QSpinBox, QDoubleSpinBox {
    background-color: #1f1f1f;
    color: #ffffff;
    border: 1px solid #2b2b2b;
    border-radius: 8px;
    padding: 6px;
}

QLineEdit:focus, QComboBox:focus, QTextEdit:focus, QListWidget:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #00c896;
}

/* Primary button */
QPushButton#Primary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00c853, stop:1 #64dd17);
    color: black;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton#Primary:hover {
    background-color: #00ddb0;
}

/* Secondary button (outline) */
QPushButton#Secondary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #536dfe, stop:1 #9c27b0);
    color: white;
    border-radius: 8px;
    padding: 8px 16px;
}

QPushButton#Secondary:hover {
    background-color: #242424;
}

/* Drag & Drop Zone */
QFrame#dropZone {
    border: 2px dashed #64dd17;
    border-radius: 12px;
    background-color: #1a1a1a;
    min-height: 200px;
}
QLabel#dropLabel {
    color: #aaa;
    font-size: 16px;
}

/* Progress bars */
QProgressBar {
    border: 1px solid #2b2b2b;
    border-radius: 10px;
    background: #1a1a1a;
    color: #f5f5f5;
    text-align: center;
    padding: 2px;
}
QProgressBar::chunk {
    background-color: #00c896;
    border-radius: 10px;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #161616;
    width: 10px;
    margin: 0;
    border-radius: 6px;
}
QScrollBar::handle:vertical {
    background: #2b2b2b;
    min-height: 30px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background: #00c896;
}
QScrollBar:horizontal {
    background: #161616;
    height: 10px;
    margin: 0;
    border-radius: 6px;
}
QScrollBar::handle:horizontal {
    background: #2b2b2b;
    min-width: 30px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal:hover {
    background: #00c896;
}

/* Tooltips */
QToolTip {
    background-color: #1f1f1f;
    color: #f5f5f5;
    border: 1px solid #2a2a2a;
    padding: 6px;
    border-radius: 8px;
}
