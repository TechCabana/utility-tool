/* ===== Modern Dark Theme - Utility Tool ===== */

/* Base Styles */
QWidget {
    background-color: #0f0f0f;
    color: #e5e5e5;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: #0f0f0f;
    color: #ffffff;
}

/* ===== Sidebar Styles ===== */
#Sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #1a1a1a, stop:1 #151515);
    border: none;
    border-right: 1px solid #2a2a2a;
    border-radius: 0px;
}

/* App Title in Sidebar */
#AppTitle {
    font-size: 20px;
    font-weight: 700;
    color: #00d4aa;
    padding: 6px 8px 20px 8px;
    margin-bottom: 12px;
}

/* Sidebar Navigation Buttons */
#Sidebar QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 10px;
    padding: 12px 16px;
    color: #a0a0a0;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
    margin: 0px 0px 8px 0px;
}

#Sidebar QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #e5e5e5;
}

#Sidebar QPushButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #00d4aa, stop:1 #00a8e8);
    color: #ffffff;
    font-weight: 600;
    border: none;
}

/* ===== Cards & Panels ===== */
QFrame#Card {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #1a1a1a, stop:1 #181818);
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    padding: 24px;
}

/* ===== Typography ===== */
QLabel#H1 {
    font-size: 28px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 8px;
    padding: 0px;
}

QLabel#H2 {
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
    margin: 0px 0px 16px 0px;
    padding: 0px;
}

QLabel#FormLabel {
    font-size: 13px;
    font-weight: 500;
    color: #b0b0b0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ===== Form Inputs ===== */
QLineEdit, QTextEdit {
    background-color: #1a1a1a;
    color: #e5e5e5;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 14px;
    selection-background-color: #00d4aa;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #00d4aa;
    background-color: #1a1a1a;
    outline: none;
}

QLineEdit:hover, QTextEdit:hover {
    border-color: #3a3a3a;
}

/* ===== Combo Boxes ===== */
QComboBox {
    background-color: #1a1a1a;
    color: #e5e5e5;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 14px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #3a3a3a;
}

QComboBox:focus {
    border: 1px solid #00d4aa;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #a0a0a0;
    width: 0px;
    height: 0px;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    color: #e5e5e5;
    selection-background-color: #00d4aa;
    selection-color: #ffffff;
    padding: 5px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 4px;
    min-height: 25px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #2a2a2a;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #00d4aa;
    color: #ffffff;
}

/* ===== Spin Boxes ===== */
QSpinBox, QDoubleSpinBox {
    background-color: #1a1a1a;
    color: #e5e5e5;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 14px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #00d4aa;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #3a3a3a;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    background-color: #2a2a2a;
    border: none;
    border-radius: 4px;
    width: 20px;
    margin: 2px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #2a2a2a;
    border: none;
    border-radius: 4px;
    width: 20px;
    margin: 2px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #3a3a3a;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 4px solid #a0a0a0;
    width: 0px;
    height: 0px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid #a0a0a0;
    width: 0px;
    height: 0px;
}

/* ===== Sliders ===== */
QSlider::groove:horizontal {
    background: #1a1a1a;
    height: 8px;
    border-radius: 4px;
    border: 1px solid #2a2a2a;
}

QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #00d4aa, stop:1 #00a8e8);
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
    border: 2px solid #ffffff;
}

QSlider::handle:horizontal:hover {
    background: #00d4aa;
    width: 20px;
    height: 20px;
    margin: -7px 0;
    border-radius: 10px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #00d4aa, stop:1 #00a8e8);
    border-radius: 4px;
}

/* ===== Checkboxes ===== */
QCheckBox {
    color: #e5e5e5;
    spacing: 8px;
    font-size: 14px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 2px solid #2a2a2a;
    background-color: #1a1a1a;
}

QCheckBox::indicator:hover {
    border-color: #3a3a3a;
}

QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #00d4aa, stop:1 #00a8e8);
    border-color: #00d4aa;
}

QCheckBox::indicator:checked:hover {
    background: #00d4aa;
}

/* ===== Buttons ===== */
QPushButton {
    background-color: #2a2a2a;
    color: #e5e5e5;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #333333;
}

QPushButton:pressed {
    background-color: #1a1a1a;
}

QPushButton:disabled {
    background-color: #1a1a1a;
    color: #606060;
}

/* Primary Button (Gradient) */
QPushButton#Primary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #00d4aa, stop:1 #00a8e8);
    color: #ffffff;
    font-weight: 700;
}

QPushButton#Primary:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #00e5bb, stop:1 #00b9f9);
}

QPushButton#Primary:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #00c399, stop:1 #0097d7);
}

QPushButton#Primary:disabled {
    background: #2a2a2a;
    color: #606060;
}

/* Secondary Button (Outline) */
QPushButton#Secondary {
    background: transparent;
    border: 1px solid #3a3a3a;
    color: #b0b0b0;
}

QPushButton#Secondary:hover {
    border-color: #00d4aa;
    color: #00d4aa;
    background: rgba(0, 212, 170, 0.1);
}

QPushButton#Secondary:pressed {
    background: rgba(0, 212, 170, 0.2);
}

/* ===== List Widgets ===== */
QListWidget {
    background-color: #1a1a1a;
    border: 2px dashed #3a3a3a;
    border-radius: 12px;
    color: #e5e5e5;
    outline: none;
    padding: 8px;
}

QListWidget:focus {
    border-color: #00d4aa;
}

QListWidget::item {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    padding: 12px 16px;
    margin: 4px 0px;
    color: #e5e5e5;
}

QListWidget::item:hover {
    background-color: #202020;
    border-color: #3a3a3a;
}

QListWidget::item:selected {
    background-color: rgba(0, 212, 170, 0.2);
    border-color: #00d4aa;
    color: #ffffff;
}

/* ===== Drop Zone Styling ===== */
QFrame#dropZone {
    border: 2px dashed #3a3a3a;
    border-radius: 12px;
    background-color: rgba(0, 212, 170, 0.02);
    min-height: 200px;
}

QFrame#dropZone:hover {
    border-color: #00d4aa;
    background-color: rgba(0, 212, 170, 0.05);
}

QLabel#dropLabel {
    color: #a0a0a0;
    font-size: 16px;
    font-weight: 500;
}

/* ===== Progress Bars ===== */
QProgressBar {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 10px;
    text-align: center;
    color: #e5e5e5;
    font-size: 13px;
    font-weight: 600;
    height: 24px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #00d4aa, stop:1 #00a8e8);
    border-radius: 10px;
}

/* ===== Scrollbars ===== */
QScrollBar:vertical {
    background: #121212;
    width: 12px;
    border-radius: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #2a2a2a;
    min-height: 30px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #00d4aa;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #121212;
    height: 12px;
    border-radius: 6px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #2a2a2a;
    min-width: 30px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #00d4aa;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ===== Tab Widget ===== */
QTabWidget::pane {
    border: none;
    background: #0f0f0f;
    border-radius: 0px;
}

QTabBar::tab {
    background: #1a1a1a;
    color: #a0a0a0;
    padding: 12px 24px;
    border: none;
    border-radius: 8px 8px 0px 0px;
    margin-right: 4px;
    font-weight: 500;
}

QTabBar::tab:hover {
    background: #202020;
    color: #e5e5e5;
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #00d4aa, stop:1 #00a8e8);
    color: #ffffff;
    font-weight: 700;
}

/* ===== Tooltips ===== */
QToolTip {
    background-color: #1a1a1a;
    color: #e5e5e5;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
}

/* ===== Menu Bars ===== */
QMenuBar {
    background-color: #121212;
    color: #e5e5e5;
    border-bottom: 1px solid #2a2a2a;
}

QMenuBar::item {
    background: transparent;
    padding: 8px 12px;
}

QMenuBar::item:selected {
    background: #2a2a2a;
    border-radius: 4px;
}

QMenu {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    color: #e5e5e5;
    padding: 8px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #00d4aa;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #2a2a2a;
    margin: 8px 12px;
}

/* ===== Status Bar ===== */
QStatusBar {
    background-color: #121212;
    color: #a0a0a0;
    border-top: 1px solid #2a2a2a;
}

/* ===== Dialog Windows ===== */
QDialog {
    background-color: #121212;
    color: #e5e5e5;
}

QMessageBox {
    background-color: #121212;
}

QMessageBox QLabel {
    color: #e5e5e5;
}

/* ===== File Dialog ===== */
QFileDialog {
    background-color: #121212;
    color: #e5e5e5;
}

/* ===== Group Boxes ===== */
QGroupBox {
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: 600;
    color: #e5e5e5;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #00d4aa;
}

/* ===== Splitter ===== */
QSplitter::handle {
    background: #2a2a2a;
}

QSplitter::handle:hover {
    background: #00d4aa;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}